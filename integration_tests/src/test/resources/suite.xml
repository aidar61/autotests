<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="TrackStudio integration tests">
    <listeners>
        <listener class-name="com.ts.tests.runners.RetryTransformer"/>
        <listener class-name="com.ts.common.listeners.TestListener"/>
    </listeners>
    <test name="Integration_Tests">
        <packages>
            <package name="com.ts.integration.tests.sla"/>
            <package name="com.ts.integration.tests.proc_sla_bug"/>
            <package name="com.ts.integration.tests.proc_sla_feature"/>
        </packages>
    </test>
    <test name="Sla_Bug">
        <packages>
            <package name="com.ts.integration.tests.proc_sla_bug"/>
        </packages>
    </test>
    <test name="Sla_Feature">
        <packages>
            <package name="com.ts.integration.tests.proc_sla_feature"/>
        </packages>
    </test>
</suite>