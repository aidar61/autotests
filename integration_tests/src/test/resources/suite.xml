<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="TrackStudio integration tests">
    <listeners>
        <listener class-name="com.ts.tests.runners.RetryTransformer"/>
        <listener class-name="com.ts.common.listeners.LogCatchListener"/>
    </listeners>
    <test name="Ts tests">
        <classes>
            <class name="com.ts.integration.tests.sla.SlaTaskTest"/>
            <class name="com.ts.integration.tests.sla.SlaBugTest"/>
            <class name="com.ts.integration.tests.sla.SlaFeatureTest"/>
            <class name="com.ts.integration.tests.sla.SlaTaskTestNegative"/>
        </classes>
    </test>
</suite>